# ── Azure AD ──────────────────────────────────────────────────────────────────
# From your App Registration in https://portal.azure.com
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here

# ── Teams Bot ─────────────────────────────────────────────────────────────────
# BOT_APP_ID is usually the same as AZURE_CLIENT_ID if using the same App Registration
BOT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BOT_APP_SECRET=your-bot-secret-here

# ── Attendance settings ────────────────────────────────────────────────────────
# Run: GET /me/calendarView in Graph Explorer and check locations[0].displayName
# for the value your tenant uses when an employee sets "In office" in Outlook
OFFICE_LOCATION_LABEL=Office

# Monthly in-office day target
RTO_TARGET=10

# Timezone for the 9am daily bot message (IANA timezone name)
OFFICE_TIMEZONE=America/New_York

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Random secret for the internal /api/bot/send-daily trigger endpoint
BOT_SCHEDULER_SECRET=change-me-to-a-random-string

# SQLite database file path (relative to backend directory)
DB_PATH=./data/rto.db
